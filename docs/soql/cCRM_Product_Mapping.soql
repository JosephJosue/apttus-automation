-- G05. cCRM_Product_Mapping — org-side input for the release delta.
-- Run in Salesforce, copy the full result INCLUDING headers, and paste it
-- into the 'cCRM_Product_Mapping' sheet of SOQL Exports/<prod|itest4>/SOQL_Exports_<YYYY-MM-DD>.xlsx
-- (query as documented in the original workbook's ReadMe sheet)
SELECT Apttus_Product__r.APTS_Ext_ID__c, Apttus_Product__r.Name, CCRM_Product__r.APTS_Ext_ID__c, CCRM_Product__r.Name, Service_Plan_Type__c
FROM APTS_Apttus_cCRM_Product_Mapping__c
