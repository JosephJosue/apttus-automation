-- G06. CFD_Exhibits_Definitions — org-side input for the release delta.
-- Run in Workbench / Data Loader, export as CSV, save as:
--   SOQL Exports/<prod|itest4>/CFD_Exhibits_<YYYY-MM-DD>.csv
SELECT APTS_Ext_ID__c,
       APTS_Product_Code__c,
       APTS_Code__c,
       APTS_Description__c,
       APTS_Product_Description__c,
       APTS_Type__c,
       Product__r.APTS_Ext_ID__c
FROM APTS_Product_Exhibit_Definition_Mapping__c
