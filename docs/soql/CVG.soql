-- G02. CVG — org-side input for the release delta.
-- Run in Salesforce, copy the full result INCLUDING headers, and paste it
-- into the 'CVG' sheet of SOQL Exports/<prod|itest4>/SOQL_Exports_<YYYY-MM-DD>.xlsx
-- (query as documented in the original workbook's ReadMe sheet)
SELECT Name, APTS_Ext_ID__c, Description__c, APTS_Exclude_From_CFD__c, Service_Group__c, Service_Group_Description__c
FROM APTS_CVG__c
