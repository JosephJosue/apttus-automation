-- G03. CVG_Mapping — org-side input for the release delta.
-- Run in Workbench / Data Loader, export as CSV, save as:
--   SOQL Exports/<prod|itest4>/CVG_Mapping_<YYYY-MM-DD>.csv
SELECT APTS_Ext_ID__c,
       Name,
       APTS_Active__c,
       APTS_CVG__r.APTS_Ext_ID__c,
       APTS_CVG__r.Name,
       APTS_Product__r.APTS_Ext_ID__c,
       APTS_Product__r.Name,
       APTS_Quantity__c,
       APTS_Check_Eligibility__c,
       APTS_Eligibility_Message__c
FROM APTS_CVG_Mapping__c
