-- G04. Product_Options — org-side input for the release delta.
-- Run in Salesforce, copy the full result INCLUDING headers, and paste it
-- into the 'Product_Options' sheet of SOQL Exports/<prod|itest4>/SOQL_Exports_<YYYY-MM-DD>.xlsx
-- (query as documented in the original workbook's ReadMe sheet)
SELECT Name, ExternalId__c, Product__r.APTS_Ext_ID__c, Product__r.Name, Option__r.APTS_Ext_ID__c, Option__r.Name
FROM M2O_ProductOptions__c
