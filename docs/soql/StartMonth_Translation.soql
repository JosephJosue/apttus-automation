-- L05. StartMonth_Translation — org-side input for the release delta.
-- Run in Salesforce, copy the full result INCLUDING headers, and paste it
-- into the 'StartMonth_Translation' sheet of SOQL Exports/<prod|itest4>/SOQL_Exports_<YYYY-MM-DD>.xlsx
-- (query as documented in the original workbook's ReadMe sheet)
SELECT Name, APTS_Ext_Id__c, APTS_CFD_Language__c, APTS_Translated_value__c, APTS_Exclude_from_CFD__c, APTS_Type__c
FROM APTS_CFD_Localization_Support__c
WHERE APTS_Type__c = 'Start Month'
