-- L06. Sales_Text — org-side input for the release delta.
-- Run in Salesforce, copy the full result INCLUDING headers, and paste it
-- into the 'Sales_Text' sheet of SOQL Exports/<prod|itest4>/SOQL_Exports_<YYYY-MM-DD>.xlsx
-- (query as documented in the original workbook's ReadMe sheet)
SELECT APTS_Ext_ID__c, Apttus_Config2__ProductId__r.APTS_Ext_ID__c, Apttus_Config2__ProductId__r.Name, Apttus_Config2__ProductCode__c, Apttus_Config2__Name__c, APTS_Country_Code__c, APTS_Language__c, APTS_Entitlement_Category__c, APTS_Entitlement_SubCategory__c, Apttus_Config2__Description__c, APTS_Long_Sales_Text__c, APTS_Exclude_From_CFD__c
FROM Apttus_Config2__ProductTranslation__c
WHERE Apttus_Config2__ProductId__r.Apttus_Config2__ProductType__c = 'Service' AND (NOT Apttus_Config2__ProductId__r.APTS_Ext_ID__c LIKE 'SVC%')
ORDER BY APTS_Country_Code__c
