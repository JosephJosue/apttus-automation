-- L01. cCRM_Eq_Price_Relevant_List — org-side input for the release delta.
-- Run in Salesforce, copy the full result INCLUDING headers, and paste it
-- into the 'Eq_Price_Relevant_List' sheet of SOQL Exports/<prod|itest4>/SOQL_Exports_<YYYY-MM-DD>.xlsx
-- (query as documented in the original workbook's ReadMe sheet)
SELECT Name, APTS_Ext_ID__c, APTS_Country__c, APTS_Product__r.APTS_Ext_ID__c, APTS_Product__r.Name
FROM Apttus_cCRM_Equipmnt_Price_Relevant_lst__c
