-- L01. cCRM_Eq_Price_Relevant_List — org-side input for the release delta.
-- Run in Workbench / Data Loader, export as CSV, save as:
--   SOQL Exports/<prod|itest4>/Eq_Price_Relevant_List_<YYYY-MM-DD>.csv
SELECT Name,
       APTS_Ext_ID__c,
       APTS_Country__c,
       APTS_Product__r.APTS_Ext_ID__c,
       APTS_Product__r.Name
FROM Apttus_cCRM_Equipmnt_Price_Relevant_lst__c
